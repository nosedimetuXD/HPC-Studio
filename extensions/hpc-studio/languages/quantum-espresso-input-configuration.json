{
	"comments": {
		"lineComment": "!"
	},
	"brackets": [
		["(", ")"],
		["[", "]"]
	],
	"autoClosingPairs": [
		{ "open": "'", "close": "'" },
		{ "open": "\"", "close": "\"" },
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" }
	],
	"surroundingPairs": [
		["'", "'"],
		["\"", "\""],
		["(", ")"],
		["[", "]"]
	],
	"folding": {
		"markers": {
			"start": "^\\s*&[A-Za-z0-9_]+",
			"end": "^\\s*/\\s*$"
		}
	},
	"wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
