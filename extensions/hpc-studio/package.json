{
	"name": "hpc-studio",
	"displayName": "HPC Studio Core",
	"description": "Core integration engine for HPC Studio: Sidecar supervisor, cluster connectivity, and scientific simulation languages",
	"version": "1.0.0",
	"publisher": "hpc-studio",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"categories": [
		"Programming Languages",
		"Other"
	],
	"extensionKind": [
		"workspace",
		"ui"
	],
	"main": "./out/extension",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "hpc-studio.startSidecar",
				"title": "HPC Studio: Start Backend Server",
				"category": "HPC Studio"
			},
			{
				"command": "hpc-studio.stopSidecar",
				"title": "HPC Studio: Stop Backend Server",
				"category": "HPC Studio"
			},
			{
				"command": "hpc-studio.restartSidecar",
				"title": "HPC Studio: Restart Backend Server",
				"category": "HPC Studio"
			},
			{
				"command": "hpc-studio.checkStatus",
				"title": "HPC Studio: Show Backend Status",
				"category": "HPC Studio"
			}
		],
		"configuration": {
			"title": "HPC Studio",
			"properties": {
				"hpc-studio.pythonPath": {
					"type": "string",
					"default": "",
					"description": "Path to Python interpreter for HPC Studio backend. Leave empty to auto-detect virtual environments or system Python."
				},
				"hpc-studio.autoStartSidecar": {
					"type": "boolean",
					"default": true,
					"description": "Automatically start the Python backend sidecar server when HPC Studio starts."
				},
				"hpc-studio.serverHost": {
					"type": "string",
					"default": "127.0.0.1",
					"description": "Host address for HPC Studio backend server."
				},
				"hpc-studio.serverPort": {
					"type": "number",
					"default": 0,
					"description": "Port number for HPC Studio backend server (0 for random dynamic port)."
				},
				"hpc-studio.logLevel": {
					"type": "string",
					"enum": [
						"debug",
						"info",
						"warning",
						"error"
					],
					"default": "info",
					"description": "Log verbosity level for HPC Studio backend server."
				}
			}
		},
		"languages": [
			{
				"id": "quantum-espresso-input",
				"aliases": [
					"Quantum ESPRESSO Input",
					"qe-in"
				],
				"extensions": [
					".in",
					".pwi"
				],
				"configuration": "./languages/quantum-espresso-input-configuration.json"
			},
			{
				"id": "quantum-espresso-output",
				"aliases": [
					"Quantum ESPRESSO Output",
					"qe-out"
				],
				"extensions": [
					".out",
					".pwo"
				],
				"configuration": "./languages/quantum-espresso-output-configuration.json"
			},
			{
				"id": "slurm",
				"aliases": [
					"Slurm",
					"slurm"
				],
				"extensions": [
					".slurm",
					".sbatch"
				],
				"filenames": [
					"slurm.job"
				],
				"configuration": "./languages/slurm-configuration.json"
			},
			{
				"id": "cif",
				"aliases": [
					"Crystallographic Information File",
					"cif"
				],
				"extensions": [
					".cif"
				],
				"configuration": "./languages/cif-configuration.json"
			},
			{
				"id": "xyz",
				"aliases": [
					"Cartesian Coordinate File",
					"xyz"
				],
				"extensions": [
					".xyz"
				],
				"configuration": "./languages/xyz-configuration.json"
			},
			{
				"id": "upf",
				"aliases": [
					"Unified Pseudopotential Format",
					"upf"
				],
				"extensions": [
					".UPF",
					".upf"
				],
				"configuration": "./languages/upf-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "quantum-espresso-input",
				"scopeName": "source.qe-in",
				"path": "./syntaxes/quantum-espresso-input.tmLanguage.json"
			},
			{
				"language": "quantum-espresso-output",
				"scopeName": "source.qe-out",
				"path": "./syntaxes/quantum-espresso-output.tmLanguage.json"
			},
			{
				"language": "slurm",
				"scopeName": "source.slurm",
				"path": "./syntaxes/slurm.tmLanguage.json"
			},
			{
				"language": "cif",
				"scopeName": "source.cif",
				"path": "./syntaxes/cif.tmLanguage.json"
			},
			{
				"language": "xyz",
				"scopeName": "source.xyz",
				"path": "./syntaxes/xyz.tmLanguage.json"
			},
			{
				"language": "upf",
				"scopeName": "source.upf",
				"path": "./syntaxes/upf.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "quantum-espresso-input",
				"path": "./snippets/quantum-espresso-input.code-snippets"
			},
			{
				"language": "slurm",
				"path": "./snippets/slurm.code-snippets"
			}
		]
	},
	"scripts": {
		"compile": "gulp compile-extension:hpc-studio",
		"watch": "gulp watch-extension:hpc-studio"
	},
	"devDependencies": {
		"@types/node": "24.x"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nosedimetuXD/HPC-Studio.git"
	}
}
