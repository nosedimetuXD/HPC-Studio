{
	"name": "hpc-studio",
	"displayName": "HPC Studio Core",
	"description": "Core integration engine for HPC Studio: Sidecar supervisor, cluster connectivity, and scientific simulation languages",
	"version": "1.0.0",
	"publisher": "hpc-studio",
	"icon": "media/icons/hpc-studio.png",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"activationEvents": [
		"onStartupFinished",
		"onCommand:hpc-studio.invokeAntigravityAgent"
	],
	"categories": [
		"Programming Languages",
		"Other"
	],
	"extensionKind": [
		"workspace",
		"ui"
	],
	"main": "./out/extension",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "hpc-studio.startSidecar",
				"title": "HPC Studio: Start Backend Server",
				"category": "HPC Studio"
			},
			{
				"command": "hpc-studio.stopSidecar",
				"title": "HPC Studio: Stop Backend Server",
				"category": "HPC Studio"
			},
			{
				"command": "hpc-studio.restartSidecar",
				"title": "HPC Studio: Restart Backend Server",
				"category": "HPC Studio"
			},
			{
				"command": "hpc-studio.checkStatus",
				"title": "HPC Studio: Show Backend Status",
				"category": "HPC Studio"
			},
			{
				"command": "hpc-studio.invokeAntigravityAgent",
				"title": "HPC Studio: Invoke Antigravity Agent",
				"category": "HPC Studio"
			},
			{
				"command": "hpc-studio.openIn3DViewer",
				"title": "HPC Studio: Open in 3D Structure Viewer",
				"category": "HPC Studio",
				"icon": "$(preview)"
			},
			{
				"command": "hpc-studio.open3DSideBySide",
				"title": "HPC Studio: Open 3D View to the Side",
				"category": "HPC Studio",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "hpc-studio.reopenAsText",
				"title": "HPC Studio: Reopen as Text",
				"category": "HPC Studio",
				"icon": "$(go-to-file)"
			},
			{
				"command": "hpc-studio.refreshClusters",
				"title": "HPC Studio: Refresh Clusters",
				"category": "HPC Studio",
				"icon": "$(refresh)"
			},
			{
				"command": "hpc-studio.connectClusterTerminal",
				"title": "HPC Studio: Connect SSH Terminal",
				"category": "HPC Studio",
				"icon": "$(terminal)"
			},
			{
				"command": "hpc-studio.pingCluster",
				"title": "HPC Studio: Ping Cluster Latency",
				"category": "HPC Studio",
				"icon": "$(pulse)"
			},
			{
				"command": "hpc-studio.addCluster",
				"title": "HPC Studio: Add Cluster Profile",
				"category": "HPC Studio",
				"icon": "$(add)"
			},
			{
				"command": "hpc-studio.addQuantumMobile",
				"title": "HPC Studio: Connect to Quantum Mobile (VirtualBox / Docker)",
				"category": "HPC Studio",
				"icon": "$(vm)"
			},
			{
				"command": "hpc-studio.quantumMobileGuide",
				"title": "HPC Studio: Open Quantum Mobile Setup Guide",
				"category": "HPC Studio",
				"icon": "$(book)"
			},
			{
				"command": "hpc-studio.openTunnel",
				"title": "HPC Studio: Open SSH Tunnel",
				"category": "HPC Studio",
				"icon": "$(plug)"
			},
			{
				"command": "hpc-studio.refreshSlurmQueue",
				"title": "HPC Studio: Refresh Slurm Queue",
				"category": "HPC Studio",
				"icon": "$(refresh)"
			},
			{
				"command": "hpc-studio.submitJob",
				"title": "HPC Studio: Submit Slurm Job (sbatch)",
				"category": "HPC Studio",
				"icon": "$(play)"
			},
			{
				"command": "hpc-studio.cancelJob",
				"title": "HPC Studio: Cancel Job (scancel)",
				"category": "HPC Studio",
				"icon": "$(stop-circle)"
			},
			{
				"command": "hpc-studio.followJobLog",
				"title": "HPC Studio: Stream Live Output (tail -f)",
				"category": "HPC Studio",
				"icon": "$(output)"
			},
			{
				"command": "hpc-studio.refreshSftp",
				"title": "HPC Studio: Refresh Remote Files",
				"category": "HPC Studio",
				"icon": "$(refresh)"
			},
			{
				"command": "hpc-studio.uploadFile",
				"title": "HPC Studio: Upload Local File",
				"category": "HPC Studio",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "hpc-studio.downloadFile",
				"title": "HPC Studio: Download Remote File",
				"category": "HPC Studio",
				"icon": "$(cloud-download)"
			}
		],
		"configuration": {
			"title": "HPC Studio",
			"properties": {
				"hpc-studio.clusters": {
					"type": "array",
					"default": [],
					"description": "Configured remote HPC clusters for SSH/Slurm/SFTP access.",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string"
							},
							"hostname": {
								"type": "string"
							},
							"user": {
								"type": "string"
							},
							"port": {
								"type": "number",
								"default": 22
							},
							"identityFile": {
								"type": "string"
							},
							"proxyJump": {
								"type": "string"
							},
							"description": {
								"type": "string"
							}
						},
						"required": [
							"name",
							"hostname"
						]
					}
				},
				"hpc-studio.pythonPath": {
					"type": "string",
					"default": "",
					"description": "Path to Python interpreter for HPC Studio backend. Leave empty to auto-detect virtual environments or system Python."
				},
				"hpc-studio.autoStartSidecar": {
					"type": "boolean",
					"default": true,
					"description": "Automatically start the Python backend sidecar server when HPC Studio starts."
				},
				"hpc-studio.serverHost": {
					"type": "string",
					"default": "127.0.0.1",
					"description": "Host address for HPC Studio backend server."
				},
				"hpc-studio.serverPort": {
					"type": "number",
					"default": 0,
					"description": "Port number for HPC Studio backend server (0 for random dynamic port)."
				},
				"hpc-studio.logLevel": {
					"type": "string",
					"enum": [
						"debug",
						"info",
						"warning",
						"error"
					],
					"default": "info",
					"description": "Log verbosity level for HPC Studio backend server."
				},
				"hpc-studio.antigravityPath": {
					"type": "string",
					"default": "",
					"description": "Custom path to the Antigravity CLI executable (agy). Leave empty to use ~/.local/bin/agy or system PATH."
				}
			}
		},
		"languages": [
			{
				"id": "quantum-espresso-input",
				"aliases": [
					"Quantum ESPRESSO Input",
					"qe-in"
				],
				"extensions": [
					".in",
					".pwi"
				],
				"configuration": "./languages/quantum-espresso-input-configuration.json"
			},
			{
				"id": "quantum-espresso-output",
				"aliases": [
					"Quantum ESPRESSO Output",
					"qe-out"
				],
				"extensions": [
					".out",
					".pwo"
				],
				"configuration": "./languages/quantum-espresso-output-configuration.json"
			},
			{
				"id": "slurm",
				"aliases": [
					"Slurm",
					"slurm"
				],
				"extensions": [
					".slurm",
					".sbatch"
				],
				"filenames": [
					"slurm.job"
				],
				"configuration": "./languages/slurm-configuration.json"
			},
			{
				"id": "cif",
				"aliases": [
					"Crystallographic Information File",
					"cif"
				],
				"extensions": [
					".cif"
				],
				"configuration": "./languages/cif-configuration.json"
			},
			{
				"id": "xyz",
				"aliases": [
					"Cartesian Coordinate File",
					"xyz"
				],
				"extensions": [
					".xyz"
				],
				"configuration": "./languages/xyz-configuration.json"
			},
			{
				"id": "upf",
				"aliases": [
					"Unified Pseudopotential Format",
					"upf"
				],
				"extensions": [
					".UPF",
					".upf"
				],
				"configuration": "./languages/upf-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "quantum-espresso-input",
				"scopeName": "source.qe-in",
				"path": "./syntaxes/quantum-espresso-input.tmLanguage.json"
			},
			{
				"language": "quantum-espresso-output",
				"scopeName": "source.qe-out",
				"path": "./syntaxes/quantum-espresso-output.tmLanguage.json"
			},
			{
				"language": "slurm",
				"scopeName": "source.slurm",
				"path": "./syntaxes/slurm.tmLanguage.json"
			},
			{
				"language": "cif",
				"scopeName": "source.cif",
				"path": "./syntaxes/cif.tmLanguage.json"
			},
			{
				"language": "xyz",
				"scopeName": "source.xyz",
				"path": "./syntaxes/xyz.tmLanguage.json"
			},
			{
				"language": "upf",
				"scopeName": "source.upf",
				"path": "./syntaxes/upf.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "quantum-espresso-input",
				"path": "./snippets/quantum-espresso-input.code-snippets"
			},
			{
				"language": "slurm",
				"path": "./snippets/slurm.code-snippets"
			}
		],
		"customEditors": [
			{
				"viewType": "hpc-studio.structure3dViewer",
				"displayName": "HPC Studio 3D Structure Viewer",
				"selector": [
					{
						"filenamePattern": "*.cif"
					},
					{
						"filenamePattern": "*.xyz"
					}
				],
				"priority": "default"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "hpc-studio.openIn3DViewer",
					"when": "editorFocus && (resourceExtname == '.cif' || resourceExtname == '.xyz')",
					"group": "navigation@1"
				},
				{
					"command": "hpc-studio.open3DSideBySide",
					"when": "editorFocus && (resourceExtname == '.cif' || resourceExtname == '.xyz')",
					"group": "navigation@2"
				},
				{
					"command": "hpc-studio.reopenAsText",
					"when": "activeCustomEditorId == 'hpc-studio.structure3dViewer'",
					"group": "navigation@3"
				}
			],
			"commandPalette": [
				{
					"command": "hpc-studio.openIn3DViewer",
					"when": "resourceExtname == '.cif' || resourceExtname == '.xyz'"
				},
				{
					"command": "hpc-studio.open3DSideBySide",
					"when": "resourceExtname == '.cif' || resourceExtname == '.xyz'"
				},
				{
					"command": "hpc-studio.reopenAsText",
					"when": "activeCustomEditorId == 'hpc-studio.structure3dViewer'"
				}
			],
			"view/title": [
				{
					"command": "hpc-studio.addCluster",
					"when": "view == hpc-studio.clustersView",
					"group": "navigation@1"
				},
				{
					"command": "hpc-studio.addQuantumMobile",
					"when": "view == hpc-studio.clustersView",
					"group": "navigation@2"
				},
				{
					"command": "hpc-studio.quantumMobileGuide",
					"when": "view == hpc-studio.clustersView",
					"group": "navigation@3"
				},
				{
					"command": "hpc-studio.refreshClusters",
					"when": "view == hpc-studio.clustersView",
					"group": "navigation@4"
				},
				{
					"command": "hpc-studio.submitJob",
					"when": "view == hpc-studio.slurmQueueView",
					"group": "navigation@1"
				},
				{
					"command": "hpc-studio.refreshSlurmQueue",
					"when": "view == hpc-studio.slurmQueueView",
					"group": "navigation@2"
				},
				{
					"command": "hpc-studio.uploadFile",
					"when": "view == hpc-studio.sftpExplorerView",
					"group": "navigation@1"
				},
				{
					"command": "hpc-studio.refreshSftp",
					"when": "view == hpc-studio.sftpExplorerView",
					"group": "navigation@2"
				}
			],
			"view/item/context": [
				{
					"command": "hpc-studio.connectClusterTerminal",
					"when": "view == hpc-studio.clustersView && viewItem == cluster-node",
					"group": "inline@1"
				},
				{
					"command": "hpc-studio.pingCluster",
					"when": "view == hpc-studio.clustersView && viewItem == cluster-node",
					"group": "inline@2"
				},
				{
					"command": "hpc-studio.openTunnel",
					"when": "view == hpc-studio.clustersView && viewItem == cluster-node",
					"group": "inline@3"
				},
				{
					"command": "hpc-studio.followJobLog",
					"when": "view == hpc-studio.slurmQueueView && viewItem =~ /^slurm-job/",
					"group": "inline@1"
				},
				{
					"command": "hpc-studio.cancelJob",
					"when": "view == hpc-studio.slurmQueueView && (viewItem == slurm-job-running || viewItem == slurm-job-pending)",
					"group": "inline@2"
				},
				{
					"command": "hpc-studio.downloadFile",
					"when": "view == hpc-studio.sftpExplorerView && viewItem == sftp-file",
					"group": "inline@1"
				},
				{
					"command": "hpc-studio.uploadFile",
					"when": "view == hpc-studio.sftpExplorerView && viewItem == sftp-directory",
					"group": "inline@1"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "hpc-studio-workbench",
					"title": "HPC Studio",
					"icon": "media/icons/hpc-studio.svg"
				}
			]
		},
		"views": {
			"hpc-studio-workbench": [
				{
					"id": "hpc-studio.clustersView",
					"name": "Remote Clusters & SSH"
				},
				{
					"id": "hpc-studio.slurmQueueView",
					"name": "Slurm Queue Monitor"
				},
				{
					"id": "hpc-studio.sftpExplorerView",
					"name": "Cluster File Transfer (SFTP)"
				}
			]
		}
	},
	"scripts": {
		"compile": "gulp compile-extension:hpc-studio",
		"watch": "gulp watch-extension:hpc-studio",
		"package": "vsce package --no-dependencies"
	},
	"devDependencies": {
		"@types/node": "24.x"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nosedimetuXD/HPC-Studio.git"
	},
	"dependencies": {
		"three": "^0.186.1"
	}
}
