	"QE &CONTROL Block": {
		"prefix": ["qe-control", "control-block"],
		"description": "Quantum ESPRESSO &CONTROL namelist block",
		"body": [
			"&CONTROL",
			"  calculation = '${1|scf,nscf,bands,relax,md,vc-relax,vc-md|}',",
			"  restart_mode = '${2|from_scratch,restart|}',",
			"  prefix = '${3:prefix}',",
			"  outdir = '${4:./tmp/}',",
			"  pseudo_dir = '${5:./pseudo/}',",
			"  tprnfor = ${6|.true.,.false.|},",
			"  tstress = ${7|.true.,.false.|}",
			"/",
			"$0"
		]
	},
