{
	"Slurm Standard CPU Job": {
		"prefix": ["sbatch-cpu", "slurm-cpu"],
		"description": "Standard single-node multi-core CPU Slurm batch script",
		"body": [
			"#!/bin/bash",
			"#SBATCH --job-name=${1:my_job}",
			"#SBATCH --partition=${2:compute}",
			"#SBATCH --nodes=1",
			"#SBATCH --ntasks=1",
			"#SBATCH --cpus-per-task=${3:16}",
			"#SBATCH --time=${4:02:00:00}",
			"#SBATCH --mem=${5:32G}",
			"#SBATCH --output=${6:%x_%j.out}",
			"#SBATCH --error=${7:%x_%j.err}",
			"",
			"# Environment setup",
			"module purge",
			"module load ${8:gcc/12.2.0}",
			"",
			"export OMP_NUM_THREADS=\\$SLURM_CPUS_PER_TASK",
			"",
			"# Execution",
			"echo \"Starting job \\$SLURM_JOB_ID on \\$(hostname) at \\$(date)\"",
			"${9:./my_program}",
			"echo \"Job finished at \\$(date)\"",
			"$0"
		]
	},
	"Slurm MPI Multinode Job": {
		"prefix": ["sbatch-mpi", "slurm-mpi"],
		"description": "High-performance multi-node distributed MPI Slurm batch script",
		"body": [
			"#!/bin/bash",
			"#SBATCH --job-name=${1:mpi_simulation}",
			"#SBATCH --partition=${2:parallel}",
			"#SBATCH --nodes=${3:4}",
			"#SBATCH --ntasks-per-node=${4:32}",
			"#SBATCH --cpus-per-task=1",
			"#SBATCH --time=${5:12:00:00}",
			"#SBATCH --mem-per-cpu=${6:2G}",
			"#SBATCH --output=${7:%x_%j.out}",
			"#SBATCH --error=${8:%x_%j.err}",
			"",
			"# Modules & Environment",
			"module purge",
			"module load ${9:intel openmpi}",
			"",
			"export OMP_NUM_THREADS=1",
			"TOTAL_TASKS=\\$((\\$SLURM_NNODES * \\$SLURM_NTASKS_PER_NODE))",
			"",
			"echo \"Nodes allocated: \\$SLURM_JOB_NODELIST\"",
			"echo \"Total MPI tasks: \\$TOTAL_TASKS\"",
			"",
			"# MPI Execution with srun",
			"srun --mpi=pmix -n \\$TOTAL_TASKS ${10:pw.x -in input.in > output.out}",
			"$0"
		]
	},
	"Slurm NVIDIA GPU Accelerated Job": {
		"prefix": ["sbatch-gpu", "slurm-gpu"],
		"description": "GPU-accelerated job on NVIDIA clusters with CUDA",
		"body": [
			"#!/bin/bash",
			"#SBATCH --job-name=${1:gpu_workload}",
			"#SBATCH --partition=${2:gpu}",
			"#SBATCH --nodes=1",
			"#SBATCH --ntasks=1",
			"#SBATCH --cpus-per-task=${3:8}",
			"#SBATCH --gres=gpu:${4:a100}:${5:1}",
			"#SBATCH --mem=${6:64G}",
			"#SBATCH --time=${7:04:00:00}",
			"#SBATCH --output=${8:%x_%j.out}",
			"#SBATCH --error=${9:%x_%j.err}",
			"",
			"# Modules & Drivers",
			"module purge",
			"module load ${10:cuda/12.2}",
			"",
			"# Diagnostic GPU check",
			"nvidia-smi",
			"",
			"# Execution",
			"srun ${11:python train.py}",
			"$0"
		]
	}
}
