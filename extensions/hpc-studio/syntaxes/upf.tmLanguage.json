{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Unified Pseudopotential Format",
	"scopeName": "source.upf",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#tags" },
		{ "include": "#numbers" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.block.xml.upf",
					"begin": "<!--",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.xml.begin.upf" }
					},
					"end": "-->",
					"endCaptures": {
						"0": { "name": "punctuation.definition.comment.xml.end.upf" }
					}
				}
			]
		},
		"tags": {
			"patterns": [
				{
					"name": "meta.tag.upf",
					"begin": "(</?)([A-Za-z0-9_]+)",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.tag.begin.upf" },
						"2": { "name": "entity.name.tag.upf" }
					},
					"end": "(/?>)",
					"endCaptures": {
						"1": { "name": "punctuation.definition.tag.end.upf" }
					},
					"patterns": [
						{ "include": "#attributes" },
						{ "include": "#strings" }
					]
				}
			]
		},
		"attributes": {
			"patterns": [
				{
					"match": "(?i)\\b(element|pseudo_type|core_correction|functional|z_valence|total_psenergy|wfc_cutoff|rho_cutoff|l_max|mesh_size|number_of_wfc|number_of_proj|dx|xmin|rmax|zmesh|version|rel|author|date|comment|nvb|nnn|l|jchi|label|index|rcut|rcut_us|epseu)\\b\\s*(=)",
					"captures": {
						"1": { "name": "entity.other.attribute-name.upf" },
						"2": { "name": "punctuation.separator.key-value.upf" }
					}
				},
				{
					"match": "([A-Za-z0-9_\\-]+)\\s*(=)",
					"captures": {
						"1": { "name": "entity.other.attribute-name.general.upf" },
						"2": { "name": "punctuation.separator.key-value.upf" }
					}
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.upf",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.upf", "match": "\\\\." }
					]
				},
				{
					"name": "string.quoted.single.upf",
					"begin": "'",
					"end": "'",
					"patterns": [
						{ "name": "constant.character.escape.upf", "match": "\\\\." }
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.upf",
					"match": "[-+]?\\b[0-9]+\\.[0-9]+([eEdD][-+]?[0-9]+)?\\b|[-+]?\\b[0-9]*\\.[0-9]+([eEdD][-+]?[0-9]+)?\\b|[-+]?\\b[0-9]+[eEdD][-+]?[0-9]+\\b"
				},
				{
					"name": "constant.numeric.integer.upf",
					"match": "[-+]?\\b[0-9]+\\b"
				}
			]
		}
	}
}
